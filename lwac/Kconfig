#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config WASM_LWAC
	tristate "LWAC"
	default n
	depends on INTERPRETERS_WAMR
	---help---
		Enable the LWAC (Lightweight WebAssembly Application Container)

if WASM_LWAC

config WASM_LWAC_PRIORITY
	int "LWAC task priority"
	default 100

config WASM_LWAC_STACKSIZE
	int "LWAC stack size"
	default DEFAULT_TASK_STACKSIZE

config WASM_LWAC_APP_DEFAULT_STACK_SIZE
	int "Default stack size for WASM applications"
	default 2048
	---help---
		Default stack size allocated for WebAssembly applications

config WASM_LWAC_APP_DEFAULT_HEAP_SIZE
	int "Default heap size for WASM applications"
	default 4096
	---help---
		Default heap size allocated for WebAssembly applications

endif

config WASM_LWAC_TEST
	tristate "LWAC Integration Tests"
	default n
	depends on WASM_LWAC
	---help---
		Enable LWAC integration test application.
		This provides comprehensive testing of LWAC functionality
		including WebAssembly module execution, command line parsing,
		file loading, module registry, and error handling.

if WASM_LWAC_TEST

config WASM_LWAC_TEST_PRIORITY
	int "LWAC Test task priority"
	default 100

config WASM_LWAC_TEST_STACKSIZE
	int "LWAC Test stack size"
	default 2048

config WASM_LWAC_TEST_MODULE_PATH
	string "Path to WASM test module(s)"
	default "/etc"
	---help---
		Specify the directory path where the compiled WASM test modules are located for the LWAC test runner.
		This should match the installation path used in the test module Makefile.

config WASM_LWAC_TEST_AOT_COMPILE
	bool "Enable AOT compilation for test WASM modules"
	default n
	---help---
		Enable Ahead-of-Time (AOT) compilation for test WASM modules
		using wamrc compiler. This can improve runtime performance
		but requires additional compilation time and WAMRC tool.

config WASM_LWAC_TEST_AOT_FLAGS
	string "AOT compilation flags"
	default ""
	depends on WASM_LWAC_TEST_AOT_COMPILE
	---help---
		Additional flags to pass to wamrc for AOT compilation.
		Common flags include:
		--target=<arch>: Target architecture (x86_64, aarch64, riscv64, etc.)
		--enable-multi-thread: Enable multi-threading support
		--enable-tail-call: Enable tail call optimization
		--enable-simd: Enable SIMD support
		--disable-hw-bound-check: Disable hardware bounds checking

endif # WASM_LWAC_TEST
